# Copy to .env and fill in real values. .env is gitignored -- never commit it.

# Discord bot token: Discord Developer Portal -> your application -> Bot -> Reset Token.
DISCORD_TOKEN=

# Local LLM server (Ollama) that /ask sends grounded-answer requests to,
# reached over a private Tailscale network -- see docs/DEPLOYMENT.md's
# "Local LLM (Ollama + Tailscale)" section for setup on both machines.
# <laptop's Tailscale IP>:11434, e.g. 100.64.1.2:11434 -- find it by running
# `tailscale ip` on the laptop.
LLM_HOST=

# Ollama model tag to request. Must already be pulled on the LLM_HOST
# machine (`ollama pull llama3.2:3b`). Optional -- defaults to llama3.2:3b
# if unset.
LLM_MODEL=llama3.2:3b

# Seconds to wait for the Ollama call before /ask falls back to its offline
# message. Optional -- defaults to 30 if unset. Raise this if the laptop is
# slow to load the model from a cold start (first request after idle).
LLM_TIMEOUT=30

# Discord user ID of the bot owner, used to gate the admin-only /debug-last
# command (shows the most recent /ask call's full retrieval/answer detail).
# Find your own ID: Discord Settings -> Advanced -> enable Developer Mode,
# then right-click your name -> Copy User ID. Optional -- if unset,
# /debug-last is rejected for everyone.
BOT_OWNER_ID=
