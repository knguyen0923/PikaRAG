# Copy to .env and fill in real values. .env is gitignored -- never commit it.

# Discord bot token: Discord Developer Portal -> your application -> Bot -> Reset Token.
DISCORD_TOKEN=

# Local LLM server (Ollama) that /ask sends grounded-answer requests to,
# reached over a private Tailscale network -- see docs/DEPLOYMENT.md's
# "Local LLM (Ollama + Tailscale)" section for setup on both machines.
# <Ollama host's Tailscale IP>:11434, e.g. 100.64.1.2:11434 -- find it by
# running `tailscale ip` on that machine.
LLM_HOST=

# Ollama model tag to request. Must already be pulled on the LLM_HOST
# machine (`ollama pull qwen3.5:9b`). Optional -- defaults to qwen3.5:9b
# if unset.
LLM_MODEL=qwen3.5:9b

# Seconds to wait for the Ollama call before /ask falls back to its offline
# message. Optional -- defaults to 30 if unset, but thinking models (e.g.
# qwen3.5:9b, the current default) regularly need longer than that for a
# real question with retrieved context -- 90 is confirmed sufficient in
# production. Also raise this if the Ollama host is slow to load the model
# from a cold start (first request after idle).
LLM_TIMEOUT=90

# Discord user ID of the bot owner, used to gate the admin-only
# /debug-last, /stats-summary, and /llmstatus commands (full retrieval/answer
# detail on the last /ask call; aggregate /ask stats; LLM health and circuit
# breaker state, respectively). Find your own ID: Discord Settings ->
# Advanced -> enable Developer Mode, then right-click your name -> Copy
# User ID. Optional -- if unset, all three commands are rejected for
# everyone.
BOT_OWNER_ID=

# Comma-separated Discord channel IDs where plain messages (no slash
# command) are treated as directed at the bot -- answered via the same
# tool-calling loop /analyze uses, with a short rolling per-channel
# memory for natural follow-ups. Find a channel's ID: Discord Settings ->
# Advanced -> enable Developer Mode, then right-click the channel ->
# Copy Channel ID. Requires the "Message Content Intent" privileged
# intent to be enabled for this bot in the Discord Developer Portal
# (Bot -> Privileged Gateway Intents) -- without it, this feature
# silently receives no message content regardless of this setting.
# Optional -- if unset, this feature is entirely off.
CONVERSATION_CHANNEL_IDS=

# Comma-separated Discord channel IDs where the bot answers only when
# @mentioned (e.g. "@PikaRAG what's the best tera type?"), instead of
# replying to every message like CONVERSATION_CHANNEL_IDS above. Each
# mention is answered independently -- no rolling conversation history.
# Same "Message Content Intent" requirement as CONVERSATION_CHANNEL_IDS.
# Optional -- if unset, this feature is entirely off.
MENTION_CHANNEL_IDS=
