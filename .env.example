# Copy to .env and fill in real values. .env is gitignored -- never commit it.

# Discord bot token: Discord Developer Portal -> your application -> Bot -> Reset Token.
DISCORD_TOKEN=

# Anthropic API key: console.anthropic.com -> Settings -> API Keys.
# Set a prepaid budget cap under Settings -> Billing before generating this --
# see docs/DEPLOYMENT.md for why.
ANTHROPIC_API_KEY=
